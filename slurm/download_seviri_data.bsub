#!/bin/bash
#SBATCH -J download_seviri_data
#SBATCH -t 08:00:00
#SBATCH -N 1
#SBATCH -n 8
#SBATCH --mem-per-cpu=8096
#SBATCH -q debug
#SBATCH --mail-type=END,FAIL
#SBATCH --output=/cluster/work/climate/dnikolo/Job_output/Output/%x.%j.out
#SBATCH --error=/cluster/work/climate/dnikolo/Job_output/Error/%x.%j.err
set -e

date
print_usage() {
    printf "Usage: ..."
}



#Copy files to local scratch
# export TMPDIR="/cluster/work/climate/dnikolo/dump"

SEVIRI_DIR=/cluster/work/climate/dnikolo/IceCloudNet_Data/SEVIRI
ENV_BIN_DIR=/cluster/work/climate/dnikolo/flex_trkr_2/bin



#Change variable to counteract a common error in PyFLEXTRKR
module load stack/2024-06 gcc/12.2.0 openmpi/4.1.6 nco ffmpeg/6.0 hdf5 

#Load pyflextrkr python
source "${ENV_BIN_DIR}"/activate
cd $SEVIRI_DIR || exit
eumdac download -c EO:EUM:DAT:MSG:HRSEVIRI --start 2010-01-02T00:00:00 --end 2010-02-01T00:00:00
if [ $? -ne 0 ]; then
    echo "Eumdac script failed, exiting."
    exit 1
fi


date
